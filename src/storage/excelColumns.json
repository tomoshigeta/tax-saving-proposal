    { "header": "固定資産税・都市計画税(年額)", "required": true, "kind": "yen", "example": 80000, "width": 24 },
    { "header": "現在年齢", "required": true, "kind": "years", "example": 50, "width": 10 },
    { "header": "試算期間(年)", "required": false, "kind": "years", "example": 15, "width": 12 },
